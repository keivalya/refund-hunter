# AgentPhone credentials (get from agentphone.ai/dashboard)
AGENTPHONE_API_KEY=sk_live_your_key_here
AGENTPHONE_AGENT_ID=your_agent_id
AGENTPHONE_NUMBER_ID=your_number_id
AGENTPHONE_PHONE_NUMBER=+1XXXXXXXXXX
AGENTPHONE_ACCOUNT_ID=your_account_id

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Google AI Studio (Gemini) — get from aistudio.google.com
GOOGLE_AI_API_KEY=your_gemini_key

# Browser Use (Cloud SDK) — get from cloud.browser-use.com/settings
BROWSER_USE_API_KEY=your_browser_use_key
